#!/usr/bin/env python3
"""IDSL Lab LaTeX: installation and service management, using only the stdlib."""
import sys

if __name__ == '__main__':
    if sys.argv[1:2] == ['local'] or sys.platform == 'darwin':
        from deploy.local import main
        main(sys.argv[2:] if sys.argv[1:2] == ['local'] else sys.argv[1:])
    else:
        from deploy.launcher import main
        main()
